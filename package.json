{
  "name": "keytomic-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Public, stateless MCP adapter for Keytomic Quick Audits and use in other Keytomic products. This adapter is designed to be used with the Keytomic MCP protocol and provides a simple interface for interacting with the protocol.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "biome check .",
    "dev": "node --watch --env-file=.env --import=tsx src/server.ts",
    "format": "biome format --write .",
    "start": "node dist/server.js",
    "test": "pnpm build && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.0.12",
    "@modelcontextprotocol/hono": "2.0.0-beta.5",
    "@modelcontextprotocol/server": "2.0.0-beta.5",
    "hono": "4.12.32",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
